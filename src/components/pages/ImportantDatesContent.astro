---
import { type Locale } from '@utils/locale'
interface Props {
  locale: Locale
}
const { locale } = Astro.props
---

<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
  <h1 class="text-4xl font-bold mb-12 text-center">
    {locale === 'th' ? 'กำหนดการสำคัญ' : 'Important Dates'}
  </h1>

  <div class="max-w-3xl mx-auto">
    <div class="relative">
      <!-- Timeline -->
      <div class="space-y-8">
        <!-- Date 1 -->
        <div class="flex">
          <div class="flex flex-col items-center">
            <div
              class="flex items-center justify-center h-12 w-12 rounded-full bg-[#9E76B4] text-white font-bold"
            >
              1
            </div>
            <div class="w-1 h-24 bg-gray-300 mt-2"></div>
          </div>
          <div class="ml-6 pb-4">
            <h3 class="text-xl font-bold text-[#9E76B4]">
              {
                locale === 'th'
                  ? 'เปิดรับบทความฉบับเต็ม'
                  : 'Opening for Full Paper Submission'
              }
            </h3>
            <p class="text-gray-600 mt-1">
              {
                locale === 'th'
                  ? '1 ธันวาคม 2026 - 31 มกราคม 2027'
                  : 'December 1, 2026 - January 31, 2027'
              }
            </p>
            <p class="text-gray-700 mt-2">
              {
                locale === 'th'
                  ? 'ส่งบทความฉบับสมบูรณ์ (full manuscript) ผ่านระบบส่งบทความออนไลน์'
                  : 'Submit your completed papers (full manuscripts) through the online submission portal.'
              }
            </p>
          </div>
        </div>

        <!-- Date 2 -->
        <div class="flex">
          <div class="flex flex-col items-center">
            <div
              class="flex items-center justify-center h-12 w-12 rounded-full bg-green-600 text-white font-bold"
            >
              2
            </div>
            <div class="w-1 h-24 bg-gray-300 mt-2"></div>
          </div>
          <div class="ml-6 pb-4">
            <h3 class="text-xl font-bold text-green-600">
              {
                locale === 'th'
                  ? 'ประกาศผลการตอบรับบทความ'
                  : 'Paper Acceptance Notification'
              }
            </h3>
            <p class="text-gray-600 mt-1">
              {locale === 'th' ? '1 มีนาคม 2027' : 'March 1, 2027'}
            </p>
            <p class="text-gray-700 mt-2">
              {
                locale === 'th'
                  ? 'ผู้ส่งบทความจะได้รับแจ้งผลการประเมินและผลการตอบรับ'
                  : 'Authors will be notified of the peer review results and acceptance decisions.'
              }
            </p>
          </div>
        </div>

        <!-- Date 3 -->
        <div class="flex">
          <div class="flex flex-col items-center">
            <div
              class="flex items-center justify-center h-12 w-12 rounded-full bg-purple-600 text-white font-bold"
            >
              3
            </div>
            <div class="w-1 h-24 bg-gray-300 mt-2"></div>
          </div>
          <div class="ml-6 pb-4">
            <h3 class="text-xl font-bold text-purple-600">
              {
                locale === 'th'
                  ? 'กำหนดส่งบทความฉบับแก้ไข'
                  : 'Revised Paper Submission Deadline'
              }
            </h3>
            <p class="text-gray-600 mt-1">
              {locale === 'th' ? '24 เมษายน 2027' : 'April 24, 2027'}
            </p>
            <p class="text-gray-700 mt-2">
              {
                locale === 'th'
                  ? 'ส่งบทความฉบับปรับแก้ตามข้อคิดเห็นและข้อเสนอแนะของผู้ทรงคุณวุฒิ'
                  : 'Submit revised papers incorporating reviewer comments and suggestions.'
              }
            </p>
          </div>
        </div>

        <!-- Date 4 -->
        <div class="flex">
          <div class="flex flex-col items-center">
            <div
              class="flex items-center justify-center h-12 w-12 rounded-full bg-orange-600 text-white font-bold"
            >
              4
            </div>
            <div class="w-1 h-24 bg-gray-300 mt-2"></div>
          </div>
          <div class="ml-6 pb-4">
            <h3 class="text-xl font-bold text-orange-600">
              {
                locale === 'th'
                  ? 'ลงทะเบียนเข้าร่วมการประชุม'
                  : 'Conference Registration'
              }
            </h3>
            <p class="text-gray-600 mt-1">
              {
                locale === 'th'
                  ? '5 มีนาคม - 30 เมษายน 2027 (Early Bird สิ้นสุดวันที่ 31 มีนาคม)'
                  : 'March 5 - April 30, 2027 (Early Bird ends March 31)'
              }
            </p>
            <p class="text-gray-700 mt-2">
              {
                locale === 'th'
                  ? 'ลงทะเบียนเข้าร่วมการประชุม'
                  : 'Register for the conference.'
              }
            </p>
          </div>
        </div>

        <!-- Date 5 -->
        <div class="flex">
          <div class="flex flex-col items-center">
            <div
              class="flex items-center justify-center h-12 w-12 rounded-full bg-red-600 text-white font-bold"
            >
              5
            </div>
          </div>
          <div class="ml-6 pb-4">
            <h3 class="text-xl font-bold text-red-600">
              {locale === 'th' ? 'วันจัดการประชุม' : 'Conference Dates'}
            </h3>
            <p class="text-gray-600 mt-1">
              {locale === 'th' ? '12-14 พฤษภาคม 2027' : 'May 12-14, 2027'}
            </p>
            <p class="text-gray-700 mt-2">
              {
                locale === 'th'
                  ? 'การนำเสนอบทความและกิจกรรมการประชุม ณ เชียงใหม่ แกรนด์วิว โฮเทล แอนด์ คอนเวนชั่น เซ็นเตอร์ จังหวัดเชียงใหม่'
                  : 'Paper presentations and conference activities at Chiangmai Grandview Hotel & Convention Center, Chiang Mai.'
              }
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>
